# 复制为 deploy/.env 后按需修改；.env 不提交到 Git
# 推荐：powershell -File deploy/gen-env.ps1   或   bash deploy/gen-env.sh
MYSQL_ROOT_PASSWORD=root
RABBITMQ_USER=booth
RABBITMQ_PASSWORD=booth123
ES_VERSION=8.17.0

# Nacos 3.0 必填：至少 32 字节的 Base64 字符串。留空会导致注册中心起不来或极不安全。
# 用 gen-env 脚本生成，或：openssl rand -base64 32
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=booth-server
NACOS_AUTH_IDENTITY_VALUE=

# —— 仓库默认偏安全（false / 仅 health）——
# 下列「本机演示」在 gen-env 生成 .env 时会写成 true，方便克隆即玩；
# 若手写 .env 且要收口，保持注释或 false 即可。
BOOTH_PAY_MOCK_ENABLED=false
BOOTH_PAY_ALLOW_DEV_SECRET=false
API_DOCS_ENABLED=false
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info

# —— 本机演示建议打开（面试官自测）——
# BOOTH_PAY_MOCK_ENABLED=true
# BOOTH_PAY_ALLOW_DEV_SECRET=true
# API_DOCS_ENABLED=true
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus

# BOOTH_SECURITY_SECRET=  # 生产必填强随机；本地可继续用代码默认并配合 ALLOW_DEV_SECRET

# —— obs profile 可选 ——
# GF_AUTH_ANONYMOUS_ENABLED=true
