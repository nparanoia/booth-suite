# OpenAI 兼容接口。密钥留空时走规则分流；填写密钥且未关闭开关时，由模型选择工具。
# 复制本文件为 .env 后再填密钥，不要把真实密钥写进本文件。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_CHAT_MODEL=deepseek-chat
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# compose 默认 false（无密钥也能起）；本机有真实密钥时再 true
BOOTH_AGENT_LLM_ENABLED=false
# auto | ngram | openai。DeepSeek 无兼容 embedding 时请用 ngram
BOOTH_AGENT_EMBEDDING_PROVIDER=ngram

# booth-cloud 网关（本机 jar 用 localhost；docker compose 请用 AGENT_GATEWAY_URL，勿把 127.0.0.1 传进容器）
BOOTH_GATEWAY_BASE_URL=http://localhost:8080
# AGENT_GATEWAY_URL=http://host.docker.internal:8080

# Redis（默认可与 booth-cloud 共用 6379；compose 里独立实例映射 6380）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 知识库 / outbox / 确认审计。compose 默认映射 5433。
BOOTH_AGENT_DB_URL=jdbc:postgresql://127.0.0.1:5433/booth_agent?connectTimeout=5&socketTimeout=15
BOOTH_AGENT_DB_USER=booth
BOOTH_AGENT_DB_PASSWORD=boothagent

# docker compose --profile app 时网关指向宿主机
# BOOTH_GATEWAY_BASE_URL=http://host.docker.internal:8080

# API 文档默认关；本机联调打开：
# BOOTH_SWAGGER_ENABLED=true
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
